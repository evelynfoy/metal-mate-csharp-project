@model Metal_Mate_MVC.Models.ViewModels.AlertRequestViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>AlertRequest</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Metal" class="control-label"></label>
                <select asp-for="Metal"
                        asp-items="Model?.Metals"
                        class="form-select">
                </select>
                <span asp-validation-for="Metal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Currency" class="control-label"></label>
                <select asp-for="Currency"
                        asp-items="Model?.Currencies"
                        class="form-select">
                </select>
                <span asp-validation-for="Currency" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Operator" class="control-label"></label>
                <select asp-for="Operator" class="form-control">
                    <option value="GreaterThan">Greater than</option>
                    <option value="LessThan">Less than</option>
                </select>
                <span asp-validation-for="Operator" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Value" class="control-label"></label>
                <input asp-for="Value" class="form-control" />
                <span asp-validation-for="Value" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsEnabled" /> @Html.DisplayNameFor(model => model.IsEnabled)
                </label>
            </div>
            <div class="form-group mt-3 mb-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<!-- Error Area -->
@if (!string.IsNullOrEmpty(Model?.ErrorMessage))
{
    <div id="errorMessage" class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}
else
{
    <div id="errorMessage" class="alert alert-danger d-none"></div>
}

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
