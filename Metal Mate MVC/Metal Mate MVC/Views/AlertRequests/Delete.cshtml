@model Metal_Mate_MVC.Models.ViewModels.AlertRequestViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

@if (string.IsNullOrEmpty(Model?.ErrorMessage))
{
    <div>
        <h4>AlertRequest</h4>
        <hr />
        <h5 class="mt-5"">Are you sure you want to delete this?</h5>

        <dl class="row mt-5">
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Metal)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Metal)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Currency)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Currency)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Operator)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Operator)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Value)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Value)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.IsEnabled)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.IsEnabled)
            </dd>
        </dl>
    
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-action="Index">Back to List</a>
        </form>
    </div>
}

<!-- Error Area -->
@if (!string.IsNullOrEmpty(Model?.ErrorMessage))
{
    <div id="errorMessage" class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}
else
{
    <div id="errorMessage" class="alert alert-danger d-none"></div>
}