@model HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <div class="row">

        <!-- Breadcrumb column -->
        <div>
            <a class="link" href="/">Home</a>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                @if (Model?.SpotPrice != null)
                {
                    <!-- Heading Area -->
                    <header class="row">
                        <h1>Check out the latest metal prices.</h1>
                    </header>

                    <!-- Content Area -->
                    <div>
                        <p class="mt-3">
                            Metal mate is your friend if you want to keep abreast of the current spot price of various metals.
                        </p>
                        <p>
                            Below are defaulted the current spot price for three of the most common metals priced in euros.
                        </p>
                    </div>

                    <!-- Defaulted Prices Area -->
                    <div class="mt-5 grid fw-bold">
                        <div class="default-price-box">
                            <span>Gold</span>
                            <span>€@Html.DisplayFor(m => m.SpotPrice!.Price):</span>
                        </div>
                        <div class ="default-price-box">
                            <span>Silver</span>
                            <span>€@Html.DisplayFor(m => m.SilverSpotPrice!.Price)</span>
                        </div>
                        <div class="default-price-box">
                            <span>Platinum</span>
                            <span>€@Html.DisplayFor(m => m.PlatinumSpotPrice!.Price)</span>
                        </div>
                    </div>

                    <div class="mt-5 mb-5">
                        <p>
                            Below you can choose to see the current spot price details for 7 different metals in over 15 different currencies.
                        </p>
                        <p>
                            Changing the metal or currency updates the displayed price automatically.
                        </p>
                    </div>
                    

                    <!-- Filters Area -->
                    <div class="row">
                        <div class="col-12">
                            <!-- Metals -->
                            <div class="me-3 float-start">
                                <div class="form-field">
                                    <div>
                                        <label asp-for="SelectedMetal" class="form-label"></label>
                                    </div>
                                    <div>
                                        <select asp-for="SelectedMetal"
                                                asp-items="Model.Metals"
                                                class="form-select w-auto"
                                                data-url="@Url.Action("GetSpotPrice", "Home")">
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <!-- Currencies -->
                            <div>
                                <div class="form-field">
                                    <div>
                                        <label asp-for="SelectedCurrency" class="form-label"></label>
                                    </div>
                                    <div>
                                        <select asp-for="SelectedCurrency"
                                                asp-items="Model.Currencies"
                                                class="form-select w-auto"
                                                data-url="@Url.Action("GetSpotPrice", "Home")">
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Price Area -->
                    <div class="row mt-5 mb-5">
                        <div class="col-12 grid">
                            <!-- Spot Price -->
                            <div class="spot-price-box">
                                <div class="fw-bold">
                                    @Html.DisplayNameFor(m => m.SpotPrice!.Price):
                                </div>
                                <div>
                                    <span id="currencySymbol">
                                        @Html.DisplayFor(m => m.SpotPrice!.CurrencySymbol)
                                    </span>
                                    <span id="spotPrice">
                                        @Html.DisplayFor(m => m.SpotPrice!.Price)
                                    </span>
                                </div>
                            </div>
                            <!-- Exchange Rate -->
                            <div class="spot-price-box">
                                <div class="fw-bold">
                                    @Html.DisplayNameFor(m => m.SpotPrice!.ExchangeRate):
                                </div>
                                <div id="exchangeRate">
                                    @Html.DisplayFor(m => m.SpotPrice!.ExchangeRate)
                                </div>
                            </div>
                            <!-- Updated At -->
                            <div class="spot-price-box">
                                <div class="fw-bold">
                                    @Html.DisplayNameFor(m => m.SpotPrice!.UpdatedAt):
                                </div>
                                <div id="updatedAt">
                                    @Html.DisplayFor(m => m.SpotPrice!.UpdatedAt)
                                </div>
                            </div>
                        </div>
                    </div>

                    <p>
                        Click Refresh Price to retrieve the latest market price for the current selection.
                    </p>

                    <!-- Button Area -->
                    <div class="mt-5 mb-5">
                        <button id="updateButton"
                                type="button"
                                class="btn btn-gold">
                            Refresh Price
                        </button>
                    </div>
                }

                <!-- Error Area -->
                @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
                {
                    <div id="errorMessage" class="alert alert-danger">
                        @Model.ErrorMessage
                    </div>
                }
                else
                {
                    <div id="errorMessage" class="alert alert-danger d-none"></div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script src="~/js/home.js" asp-append-version="true"></script>
}