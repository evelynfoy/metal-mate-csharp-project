@model HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="container text-center">

    @if (Model?.SpotPrice != null)
    {
        <div class="row">
            <div class="column mb-4 mt-5">
                <h2>Check out the latest metal prices.</h2>
            </div>
        </div>

        <div class="d-flex justify-content-center align-items-center gap-3 mb-4">

            <label asp-for="SelectedMetal" class="form-label mb-0 fw-semibold fs-4"></label>

            <select asp-for="SelectedMetal"
                    asp-items="Model.Metals"
                    class="form-select w-auto"
                    data-url="@Url.Action("GetSpotPrice", "Home")">
            </select>

        </div>

        <div class="d-flex justify-content-center mt-4">
            <dl class="mb-0">

                <div class="d-flex align-items-center mb-3">
                    <dt class="fw-semibold me-3 fs-4">
                        @Html.DisplayNameFor(m => m.SpotPrice!.Price):
                    </dt>
                    <dd class="mb-0 fs-3">
                        <span id="currencySymbol">
                            @Html.DisplayFor(m => m.SpotPrice!.CurrencySymbol)
                        </span>
                        <span id="spotPrice" class="fw-bold">
                            @Html.DisplayFor(m => m.SpotPrice!.Price)
                        </span>
                    </dd>
                </div>

                <div class="d-flex align-items-center mb-3">
                    <dt class="fw-semibold me-3 fs-4">
                        @Html.DisplayNameFor(m => m.SpotPrice!.ExchangeRate):
                    </dt>
                    <dd class="mb-0 fs-5" id="exchangeRate">
                            @Html.DisplayFor(m => m.SpotPrice!.ExchangeRate)
                    </dd>
                </div>

                <div class="d-flex align-items-center mb-5">
                    <dt class="fw-semibold me-3 fs-4">
                        @Html.DisplayNameFor(m => m.SpotPrice!.UpdatedAt):
                    </dt>
                    <dd class="mb-0 fs-5" id="updatedAt">
                            @Html.DisplayFor(m => m.SpotPrice!.UpdatedAt)
                    </dd>
                </div>

            </dl>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
    {
        <div id="errorMessage" class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }
    else
    {
        <div id="errorMessage" class="alert alert-danger d-none"></div>
    }
</div>

@section Scripts {

    <script src="~/js/home.js" asp-append-version="true"></script>
}